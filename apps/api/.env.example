# ==============================================================================
# FlourERP Backend API Environment Template (.env.example)
# Copy this file to .env and configure your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=your-secure-jwt-secret-key-here
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Supabase PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Replace [YOUR-PASSWORD] with your actual Supabase database password
# Transaction pooler URL (Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
