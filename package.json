{
  "name": "flour-erp-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web start",
    "dev:api": "npm --prefix apps/api run dev",
    "build:api": "npm --prefix apps/api run build",
    "build:all": "npm --prefix apps/api run build && npm --prefix apps/web run build",
    "start:api": "npm --prefix apps/api start",
    "db:push": "npm --prefix apps/api run db:push",
    "db:seed": "npm --prefix apps/api run db:seed",
    "test:e2e": "npm --prefix apps/api run test:e2e",
    "test:journey": "npm --prefix apps/api run test:journey",
    "cap:build": "npm run build && npx cap sync android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
